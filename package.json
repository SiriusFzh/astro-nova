{
  "name": "astro-nova",
  "version": "1.0.0",
  "description": "AI 驱动的天文学全领域科研助手",
  "author": "SiriusFzh",
  "main": "electron/main.js",
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "electron:dev": "electron .",
    "dev": "concurrently \"npm run frontend:dev\" \"npm run electron:dev\"",
    "build": "npm run frontend:build && npm run backend:build && electron-builder",
    "backend:build": "bash scripts/build_backend.sh",
    "postinstall": "cd frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.astronova.app",
    "productName": "AstroNova",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      },
      {
        "from": "references/",
        "to": "references/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-mac.${ext}",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "AstroNova ${version}",
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AstroNova"
    },
    "publish": {
      "provider": "github",
      "owner": "SiriusFzh",
      "repo": "astro-nova"
    }
  }
}
